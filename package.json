{
  "name": "tiktok-vault-cli",
  "version": "1.0.0",
  "description": "CLI and web interface to extract and download TikTok videos without watermark",
  "main": "dist/cli.js",
  "bin": {
    "tiktok-vault": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "web": "ts-node src/cli.ts serve --port 3000"
  },
  "keywords": [
    "tiktok",
    "downloader",
    "cli",
    "typescript",
    "no-watermark",
    "video-tools"
  ],
  "author": "Autonomous Dev",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.8",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^12.0.0",
    "express": "^4.19.2",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  }
}